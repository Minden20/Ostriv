<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

<BorderPane styleClass="main-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minden.ui.controller.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <Label text="Ostriv RPG" styleClass="header-title"/>
            <Button text="Щоденник подорожей" onAction="#handleShowLogs" styleClass="action-button"/>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="stats-container">
                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="💰" styleClass="stat-icon"/>
                    <Label text="Золото:" styleClass="stat-label"/>
                    <Label fx:id="goldLabel" text="0" styleClass="stat-value-gold"/>
                </HBox>
                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="⚡" styleClass="stat-icon"/>
                    <Label text="Енергія:" styleClass="stat-label"/>
                    <Label fx:id="energyLabel" text="0" styleClass="stat-value-energy"/>
                </HBox>
            </HBox>
            <Label fx:id="userGreetingLabel" styleClass="header-user"/>
            <Button text="Вийти" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>
    
    <center>
        <StackPane fx:id="contentArea" />
    </center>
</BorderPane>
