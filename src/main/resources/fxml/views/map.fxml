<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="mapRootPane" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minden.ui.controller.MapController">
    <ScrollPane fx:id="scrollPane" styleClass="data-table" fitToWidth="false" fitToHeight="false" pannable="false" hbarPolicy="NEVER" vbarPolicy="NEVER">
        <Canvas fx:id="mapCanvas" />
    </ScrollPane>
    
    <Button fx:id="restButton" text="⛺" onAction="#handleRest" StackPane.alignment="BOTTOM_RIGHT" styleClass="rest-button">
        <StackPane.margin>
            <Insets bottom="25.0" right="25.0" />
        </StackPane.margin>
    </Button>
</StackPane>
